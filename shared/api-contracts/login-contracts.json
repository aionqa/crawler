{
  "loginAgentAPI": {
    "version": "2.0.0",
    "description": "Standardized API contract for login agent modules - ENFORCES STRICT FORMAT",
    "compliance": "MUST follow STANDARDIZED_COMMUNICATION_FORMAT.md exactly",
    "endpoints": {
      "attemptLogin": {
        "method": "POST",
        "path": "/rpc",
        "description": "Attempt login with standardized input/output format",
        "request": {
          "jsonrpc": "2.0",
          "method": "attemptLogin",
          "params": {
            "url": {
              "type": "string",
              "required": true,
              "description": "Login page URL"
            },
            "cookies": {
              "type": "array",
              "items": {
                "$ref": "#/commonTypes/Cookie"
              },
              "description": "Initial cookies to use"
            },
            "context": {
              "type": "object",
              "required": true,
              "properties": {
                "project_id": {
                  "type": "string",
                  "required": true,
                  "description": "Project identifier"
                },
                "configuration_id": {
                  "type": "string",
                  "description": "Configuration identifier"
                },
                "job_id": {
                  "type": "string",
                  "description": "Job identifier"
                },
                "credentials": {
                  "type": "object",
                  "properties": {
                    "username": {
                      "type": "string",
                      "description": "Login username"
                    },
                    "password": {
                      "type": "string",
                      "description": "Login password"
                    }
                  }
                },
                "options": {
                  "type": "object",
                  "properties": {
                    "headless": {
                      "type": "boolean",
                      "default": true,
                      "description": "Run browser in headless mode"
                    },
                    "timeout": {
                      "type": "number",
                      "default": 30000,
                      "description": "Timeout in milliseconds"
                    },
                    "max_retries": {
                      "type": "number",
                      "default": 2,
                      "description": "Maximum number of retries"
                    },
                    "enable_screenshots": {
                      "type": "boolean",
                      "default": true,
                      "description": "Enable screenshot capture"
                    },
                    "enable_video_recording": {
                      "type": "boolean",
                      "default": false,
                      "description": "Enable video recording"
                    }
                  }
                }
              }
            }
          },
          "id": {
            "type": "number",
            "description": "Request ID"
          }
        },
        "response": {
          "success": {
            "jsonrpc": "2.0",
            "result": {
              "success": {
                "type": "boolean",
                "required": true,
                "description": "AI-determined success status"
              },
              "confidence": {
                "type": "number",
                "required": true,
                "minimum": 0,
                "maximum": 100,
                "description": "AI confidence level"
              },
              "summary": {
                "type": "string",
                "required": true,
                "description": "Human-readable summary"
              },
              "result": {
                "type": "object",
                "required": true,
                "properties": {
                  "url_after": {
                    "type": "string",
                    "required": true,
                    "description": "Final URL after operation"
                  },
                  "cookies": {
                    "type": "array",
                    "items": {
                      "$ref": "#/commonTypes/Cookie"
                    },
                    "required": true,
                    "description": "Cookies after login"
                  },
                  "page_content": {
                    "type": "string",
                    "required": true,
                    "description": "HTML content of final page"
                  },
                  "page_title": {
                    "type": "string",
                    "required": true,
                    "description": "Title of final page"
                  },
                  "redirect_chain": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Array of URLs in redirect chain"
                  }
                }
              },
              "artifacts": {
                "type": "object",
                "required": true,
                "properties": {
                  "screenshots": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "filename": {
                          "type": "string",
                          "required": true
                        },
                        "data": {
                          "type": "string",
                          "required": true,
                          "description": "Base64 encoded image"
                        },
                        "timestamp": {
                          "type": "string",
                          "required": true,
                          "description": "ISO timestamp"
                        },
                        "description": {
                          "type": "string",
                          "required": true
                        }
                      }
                    },
                    "required": true
                  },
                  "video_file_id": {
                    "type": "string",
                    "description": "GridFS file ID for video recording"
                  },
                  "playwright_code": {
                    "type": "string",
                    "required": true,
                    "description": "Complete Playwright code executed"
                  },
                  "ai_prompts": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "prompt": {
                          "type": "string",
                          "required": true
                        },
                        "response": {
                          "type": "string",
                          "required": true
                        },
                        "timestamp": {
                          "type": "string",
                          "required": true,
                          "description": "ISO timestamp"
                        },
                        "purpose": {
                          "type": "string",
                          "required": true
                        }
                      }
                    },
                    "required": true
                  }
                }
              },
              "ai_analysis": {
                "type": "object",
                "required": true,
                "properties": {
                  "success_indicators": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "required": true
                  },
                  "failure_indicators": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "required": true
                  },
                  "reasoning": {
                    "type": "string",
                    "required": true,
                    "description": "AI reasoning for success/failure determination"
                  },
                  "next_actions": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Array of suggested next actions"
                  }
                }
              },
              "metadata": {
                "type": "object",
                "required": true,
                "properties": {
                  "module_name": {
                    "type": "string",
                    "required": true
                  },
                  "duration_ms": {
                    "type": "number",
                    "required": true
                  },
                  "attempts": {
                    "type": "number",
                    "required": true
                  },
                  "timestamp": {
                    "type": "string",
                    "required": true,
                    "description": "ISO timestamp"
                  }
                }
              }
            },
            "id": {
              "type": "number",
              "description": "Request ID"
            }
          },
          "error": {
            "jsonrpc": "2.0",
            "error": {
              "$ref": "#/commonTypes/Error"
            },
            "id": {
              "type": "number",
              "description": "Request ID"
            }
          }
        }
      }
    },
    "backendToAgent": {
      "description": "Standardized backend to agent communication",
      "compliance": "MUST follow STANDARDIZED_COMMUNICATION_FORMAT.md exactly",
      "request": {
        "url": {
          "type": "string",
          "required": true,
          "description": "Login page URL"
        },
        "cookies": {
          "type": "array",
          "items": {
            "$ref": "#/commonTypes/Cookie"
          },
          "description": "Initial cookies to use"
        },
        "context": {
          "type": "object",
          "required": true,
          "properties": {
            "project_id": {
              "type": "string",
              "required": true
            },
            "configuration_id": {
              "type": "string"
            },
            "job_id": {
              "type": "string"
            },
            "credentials": {
              "type": "object",
              "properties": {
                "username": {
                  "type": "string"
                },
                "password": {
                  "type": "string"
                }
              }
            },
            "options": {
              "type": "object",
              "properties": {
                "headless": {
                  "type": "boolean",
                  "default": true
                },
                "timeout": {
                  "type": "number",
                  "default": 30000
                },
                "max_retries": {
                  "type": "number",
                  "default": 2
                },
                "enable_screenshots": {
                  "type": "boolean",
                  "default": true
                },
                "enable_video_recording": {
                  "type": "boolean",
                  "default": false
                }
              }
            }
          }
        }
      },
      "response": {
        "success": {
          "type": "boolean",
          "required": true,
          "description": "AI-determined success status"
        },
        "confidence": {
          "type": "number",
          "required": true,
          "minimum": 0,
          "maximum": 100
        },
        "summary": {
          "type": "string",
          "required": true
        },
        "result": {
          "type": "object",
          "required": true,
          "description": "Standardized result object"
        },
        "artifacts": {
          "type": "object",
          "required": true,
          "description": "Standardized artifacts object"
        },
        "ai_analysis": {
          "type": "object",
          "required": true,
          "description": "Standardized AI analysis object"
        },
        "metadata": {
          "type": "object",
          "required": true,
          "description": "Standardized metadata object"
        }
      }
    }
  }
}
