# Copy this to .env and fill values
OPENAI_API_KEY=sk-...
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=spa

# Single target
TARGET_URL=https://example.com
PROJECT_NAME=example-com

# Optional credentials to store alongside the project (JSON)
CREDENTIALS_JSON={"username":"demo@example.com","password":"secret"}

# 'true' or 'false'
HEADLESS=true