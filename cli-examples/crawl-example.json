{
  "operation": "crawl",
  "url": "https://example.com",
  "context": {
    "job_id": "cli-crawl-test",
    "mode": "auto",
    "openai_api_key": "your-openai-api-key-here",
    "headless": false,
    "timeout": 30000,
    "max_pages": 10,
    "max_depth": 3
  },
  "options": {
    "follow_links": true,
    "respect_robots_txt": false,
    "screenshot_each_page": true,
    "extract_forms": true,
    "extract_links": true,
    "wait_for_navigation": true
  }
}
