{
  "name": "single-page-analyzer",
  "version": "1.0.0",
  "description": "Single target / single page analyzer that uses Playwright to load one page and GPT-5-mini to enumerate interactive elements. Saves to MongoDB.",
  "type": "module",
  "main": "singlePageAnalyzer.js",
  "scripts": {
    "install:pw": "playwright install chromium",
    "analyze": "node singlePageAnalyzer.js",
    "crawl": "node app/domainCrawler.js",
    "run:action": "node executeAction.js",
    "format": "prettier -w ../../Downloads/single-page-analyzer",
    "dev:back": "cd back && npm run dev",
    "dev:ui": "cd ui && npm run dev",
    "start:back": "cd back && npm start",
    "start:ui": "cd ui && npm run preview",
    "build:ui": "cd ui && npm run build",
    "install:all": "npm install && cd back && npm install && cd ../ui && npm install"
  },
  "dependencies": {
    "cheerio": "^1.1.2",
    "dotenv": "^16.4.5",
    "escape-string-regexp": "^5.0.0",
    "mongodb": "^6.8.0",
    "openai": "^4.56.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "playwright": "^1.55.0",
    "prettier": "^3.3.3"
  }
}
