{
  "name": "unified-crawler",
  "version": "1.0.0",
  "description": "Unified AI-powered web crawling and login automation system",
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "cli": "node src/cli.js",
    "test:login": "node src/cli.js --file cli-examples/login-example.json",
    "test:crawl": "node src/cli.js --file cli-examples/crawl-example.json",
    "test:analysis": "node src/cli.js --file cli-examples/analysis-example.json",
    "examples": "node src/cli.js --list-examples",
    "generate-payload": "node src/generate-payload.js"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "body-parser": "^1.20.2",
    "playwright": "^1.40.0",
    "openai": "^4.20.1",
    "zod": "^3.22.4",
    "axios": "^1.6.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "keywords": [
    "web-crawling",
    "automation",
    "ai",
    "playwright",
    "login"
  ],
  "author": "AionQA Team",
  "license": "MIT"
}
