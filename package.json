{
  "name": "single-page-analyzer",
  "version": "1.0.0",
  "description": "Single target / single page analyzer that uses Playwright to load one page and GPT-5-mini to enumerate interactive elements. Saves to MongoDB.",
  "type": "module",
  "main": "singlePageAnalyzer.js",
  "scripts": {
    "install:pw": "playwright install chromium",
    "analyze": "node singlePageAnalyzer.js",
    "run:action": "node executeAction.js",
    "format": "prettier -w ../../Downloads/single-page-analyzer"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "mongodb": "^6.8.0",
    "openai": "^4.56.0",
    "playwright": "^1.47.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "prettier": "^3.3.3"
  }
}